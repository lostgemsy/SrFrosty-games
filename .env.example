# Password required to publish polls (/OwnerPolls) and announcements
# (/AdminAnnouncements). Pick something only you know.
ADMIN_PASSWORD=changeme

# These two are added automatically by Vercel once you attach a KV
# (Redis) database to this project in the Vercel dashboard — you do not
# need to set them by hand. See README.md.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
