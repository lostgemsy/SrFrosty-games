{
  "version": 2,
  "routes": [
    {
      "source": "/socket.io/(.*)",
      "dest": "/api/socket.js"
    },
    {
      "source": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "source": "/",
      "dest": "/index.html"
    },
    {
      "source": "/(index|games|leaderboard|chat|suggest|settings|game|adminleaderboard|adminSuggested)",
      "dest": "/$1.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "dest": "/404.html"
    }
  ]
}
