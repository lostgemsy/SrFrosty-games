{
  "version": 2,
  "routes": [
    {
      "source": "/socket.io/(.*)",
      "dest": "/api/socket.js"
    },
    {
      "source": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "source": "/(chat|chat\\.html)",
      "dest": "/api/index.js"
    },
    {
      "source": "/",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "source": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
