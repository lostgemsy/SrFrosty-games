{
  "name": "farius-games",
  "version": "1.0.0",
  "private": true,
  "description": "Farius Games — a clean monochrome library for browser games.",
  "license": "MIT",
  "author": "Farius",
  "keywords": [
    "games",
    "unblocked",
    "arcade",
    "static-site",
    "html5"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "serve . -l 3000",
    "start": "serve . -l 3000",
    "preview": "serve . -l 3000 --single",
    "serve:api": "node server.js",
    "build": "echo \"Farius Games: static build ready\"",
    "clean": "node -e \"console.log('Nothing to clean — pure static site')\"",
    "format": "prettier --write \"**/*.{html,css,js,json,md}\" --ignore-path .gitignore",
    "lint": "echo \"Add ESLint or Stylelint if you want\"",
    "new:game": "node scripts/new-game.js"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "serve": "^14.2.4"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ]
}